# Mapbox access token (server-side only, not exposed to the browser).
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Supabase. Run `npm run supabase:start` first (starts local Supabase in
# Docker) -- these values are Supabase's fixed local-dev defaults, identical
# on every machine, not secrets. `npm run supabase:status` prints them again
# if you need a reminder.
