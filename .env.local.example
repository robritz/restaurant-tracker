# Mapbox access token (server-side only, not exposed to the browser).
# Create one at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Mapbox public token for the browser map. Separate from MAPBOX_TOKEN above:
# scope it to styles:read/fonts:read and URL-restrict it at Mapbox, since it
# is inlined into the client bundle. See docs/adr/0002-separate-public-mapbox-token.md
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Supabase. Run `npm run supabase:start` first (starts local Supabase in
# Docker), then `npm run supabase:status` to print these values and paste
# them in below.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The one Household's login. There is no self-signup: `npm run seed` (also run
# by `npm run supabase:reset`) creates this credential and the Household it
# belongs to. Pick anything for local development; keep it out of git.
HOUSEHOLD_EMAIL=
HOUSEHOLD_PASSWORD=
# Optional -- the family's display name. Defaults to "Our Household".
HOUSEHOLD_NAME=
