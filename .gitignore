# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel -- `vercel link` writes the project and org ids here. Not secret,
# but local machine state, and the CLI expects to own the directory.
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Broadened from `.env*.local` by `vercel link`, which wants any stray env
# file ignored. Kept, with the exception that matters: .env.local.example is
# committed on purpose -- it is how the required configuration is documented
# -- and a bare `.env*` silently matches it too.
.env*
!.env*.example
